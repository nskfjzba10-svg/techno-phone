  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserPublic" },
      "description": "Public user profile and immutable role metadata."
    },
    "/users/{userId}/private/info": {
      "schema": { "$ref": "#/entities/UserPrivate" },
      "description": "Owner-only private contact PII (email, phone, address, GPS coordinates)."
    },
    "/stores/{storeId}": {
      "schema": { "$ref": "#/entities/StoreProfile" },
      "description": "Iraqi electronics and repair stores directory."
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "New, used, refurbished devices and accessories listed by stores."
    },
    "/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/Booking" },
      "description": "Orders, reservations, and repair tickets."
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Verified reviews permitted only after completed bookings."
    },
    "/conversations/{threadId}": {
      "schema": { "$ref": "#/entities/ConversationThread" },
      "description": "Customer-store direct chat thread metadata."
    },
    "/conversations/{threadId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Individual messages inside a conversation thread."
    },
    "/wishlists/{wishlistId}": {
      "schema": { "$ref": "#/entities/WishlistItem" },
      "description": "Customer wishlist items with price-drop tracking."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/NotificationItem" },
      "description": "User notification feed for booking progress, replies, and price drops."
    },
    "/tradeins/{tradeinId}": {
      "schema": { "$ref": "#/entities/TradeInRequest" },
      "description": "Old device trade-in valuation requests."
    }
  }
}
